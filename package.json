{
  "name": "mint-roblox-mcp",
  "version": "0.1.0",
  "description": "Mint - MCP server bridging AI clients like Arena AI to Roblox Studio",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mint-roblox-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "roblox",
    "roblox-studio",
    "arena-ai",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
